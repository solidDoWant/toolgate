          "expr": "topk(20, sum by (\"user.email\") (increase({__name__=\"claude_code.cost.usage\",\"user.email\"=~\"$user\",\"workspace.id\"=~\"$workspace\",model=~\"$model\"}[$__range])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "user.email": "User",
              "Value": "Total"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Total",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top workspaces by tokens",
      "description": "Over the time range of the dashboard.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (\"workspace.id\") (increase({__name__=\"claude_code.token.usage\",\"user.email\"=~\"$user\",\"workspace.id\"=~\"$workspace\",model=~\"$model\"}[$__range])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true,
