          "expr": "topk(20, sum by (\"workspace.id\") (increase({__name__=\"claude_code.cost.usage\",\"user.email\"=~\"$user\",\"workspace.id\"=~\"$workspace\",model=~\"$model\"}[$__range])))",
          "datasource": {
            "type": "prometheus",
